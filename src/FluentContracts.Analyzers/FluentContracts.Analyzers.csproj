<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Analyzers load inside the consumer's compiler, which requires netstandard2.0. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!-- The DLL ships inside the FluentContracts package under analyzers/dotnet/cs,
             not as a package of its own. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

    <ItemGroup>
        <!-- 4.4.0 keeps the analyzer loadable from VS 17.4 / SDK 7.0.2xx onwards; everything used
             here is far older than that. PrivateAssets: the compiler provides these at runtime,
             and nothing may leak into the package's dependencies. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.4.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    </ItemGroup>

</Project>
