<Project Sdk="Microsoft.NET.Sdk">
    <!--General-->
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!--Package-->
    <PropertyGroup>
        <Title>Fluent Contracts</Title>
        <PackageId>FluentContracts</PackageId>
        <PackageTags>fluent contracts</PackageTags>
        <Product>FluentContracts</Product>
        <Copyright>Copyright (c) $([System.DateTime]::Now.Year) Todor Todorov</Copyright>
        <Authors>Todor Todorov (a.k.a. totollygeek)</Authors>
        <NeutralLanguage>en-US</NeutralLanguage>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://fluentcontracts.github.io</PackageProjectUrl>
        <Description>API for contract validation using fluent style.</Description>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Ship the XML docs so the summaries show up in consumers' IntelliSense. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591: AGENTS.md requires XML documentation on every public member. Every contract
             check has it; 140 members do not - the contract types, their constructors and the
             base-class properties. Until those are written this would fail the build, since
             warnings are errors. Remove this entry once the count reaches zero. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- Source Link is provided by the .NET SDK (8.0+); no package reference required. -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
        <!-- The nuget.org listing gets its own readme: the repository README relies on raw
             HTML and images from domains nuget.org does not render. -->
        <None Include="..\..\docs\PackageReadme.md" Pack="true" PackagePath="\README.md" />
    </ItemGroup>

    <!-- Polyfills language/BCL attributes (CallerArgumentExpression, nullable analysis) for netstandard2.0. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

</Project>