<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- The newest runtime the repo's SDK carries; the library resolves its net8.0 assets,
             which is what consumers on modern runtimes get. -->
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\FluentContracts\FluentContracts.csproj" />
    </ItemGroup>

</Project>
